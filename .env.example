# ---- Naya HR configuration ----
# Copy this file to .env and fill in the values.

NODE_ENV=production
PORT=3000
# Public URL people use to open the system (used in email links)
APP_URL=https://hr.naya.asia

# REQUIRED in production: a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Set to true when running behind a reverse proxy / load balancer that terminates HTTPS (Nginx, Render, Railway, etc.)
TRUST_PROXY=true

# System owner (created automatically on first start)
OWNER_EMAIL=kennylow@naya.asia
OWNER_NAME=Kenny Low
# Optional: set the owner's first password. If empty, a random one is printed in the server log on first start.
OWNER_INITIAL_PASSWORD=

# Only emails on this domain can be added as staff
ALLOWED_EMAIL_DOMAIN=naya.asia

# Sign-in session length (hours) and temporary password lifetime (days)
SESSION_HOURS=8
TEMP_PASSWORD_DAYS=7

# ---- Email (SMTP) ----
# Google Workspace example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#   SMTP_USER=hr@naya.asia, SMTP_PASS=<16-char App Password>
# Microsoft 365 example: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURE=false
# Leave SMTP_HOST empty to log emails to data/outbox.log instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Naya HR <hr@naya.asia>
# Also email super admins about new requests (they always get in-app notifications)
EMAIL_SUPER_ADMINS=false

# Storage locations (relative to project folder)
DB_PATH=data/naya-hr.db
UPLOAD_DIR=uploads
